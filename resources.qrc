<?xml version="1.0" encoding="UTF-8"?>
<RCC>
    <!-- Claude Generated - Visual Polish: Dark mode stylesheet resources -->
    <qresource prefix="/">
        <file>stylesheets/dark.qss</file>
        <file>stylesheets/light.qss</file>
    </qresource>

    <!-- Claude Generated - Qt Quick 3D viewer scene (renderer migration) -->
    <qresource prefix="/qml">
        <file>src/qml/viewer3d.qml</file>
        <!-- Claude Generated 2026 - instanced molecule content, shared by viewer3d.qml and VrScene.qml -->
        <file>src/qml/MoleculeModels.qml</file>
        <file>src/qml/viewerxr.qml</file>
        <!-- Claude Generated 2026 - headset scene and panels (shared with spikes/vr_preview) -->
        <file>src/qml/VrScene.qml</file>
        <file>src/qml/VrPanelHost.qml</file>
        <file>src/qml/VrPanel.qml</file>
        <file>src/qml/VrPanelStructure.qml</file>
        <file>src/qml/VrPanelSimulation.qml</file>
        <file>src/qml/VrPanelView.qml</file>
        <file>src/qml/VrPanelFiles.qml</file>
        <file>src/qml/VrButton.qml</file>
        <file>src/qml/VrStepper.qml</file>
        <file>src/qml/VrStyle.js</file>
    </qresource>

    <!-- Claude Generated - Phase 3B & 4A: Shader resources for advanced rendering -->
    <qresource prefix="/shaders">
        <!-- SSAO Shaders (Phase 3B - Foundation) -->
        <file>src/shaders/ssao.vert</file>
        <file>src/shaders/ssao.frag</file>
        <file>src/shaders/ssao_blur.frag</file>

        <!-- PBR Shaders (Phase 4A - Cook-Torrance BRDF) -->
        <file>src/shaders/pbr.vert</file>
        <file>src/shaders/pbr.frag</file>

        <!-- Bloom & Post-Processing Shaders (Phase 5B - HDR & Effects) -->
        <file>src/shaders/bloom_bright.frag</file>
        <file>src/shaders/blur_horizontal.frag</file>
        <file>src/shaders/blur_vertical.frag</file>
        <file>src/shaders/bloom_composite.frag</file>
        <file>src/shaders/tonemapping.frag</file>

        <!-- Atom GPU Instancing Shader (Phase 3.1 - Interactive Sim Perf) -->
        <file>src/shaders/atom_instanced.vert</file>
        <file>src/shaders/atom_instanced.frag</file>

        <!-- Bond GPU Instancing Shader (Phase 3.2 - Interactive Sim Perf) -->
        <file>src/shaders/bond_instanced.vert</file>
        <file>src/shaders/bond_instanced.frag</file>
    </qresource>
</RCC>
